Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  
    // Add a DDO Structure 
    //
    // There is no need to synchronize a DD structure on the client so we do
    // not set the Server property or send ADDOStructure. We will simply use
    // DDO's to mine data and generate HTML for our cWebHTMLBox objects.
    // It is the HTML in these objects that is sent to the client each time 
    // this page is shown.
    //
    // Also, it is important for the drill-down Navigation interface that we
    // do not set the Server property to some DDO because this will affect 
    // constraints in the next view that we navigate to.
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

    Set piMaxWidth to 1180
    
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        Set psCSSClass to "SoccerDashboardPanel"
        
        // - - - - - - - - - - - - - - -
        // Main Panel's Responsive Rules
        // - - - - - - - - - - - - - - -
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 24
            
            Set psCSSClass to "TilesGroup"
            
            Object oDashboardStyle is a cWebHtmlBox
                Set piColumnSpan to 24
                Set piHeight to 0
                Set psHtml to ''
            End_Object
    
            Object oWelcomeTile is a cWebHtmlBox
                Set piColumnSpan to 24
                Set psCSSClass to "SoccerHero"
                Set psHtml to '<div style="min-height:226px;border-radius:8px;padding:34px 40px;margin:6px 6px 18px;color:#fff;background:radial-gradient(circle at 82% 26%,rgba(247,201,72,.28),transparent 24%),radial-gradient(circle at 92% 74%,rgba(230,57,70,.16),transparent 26%),linear-gradient(135deg,#071421 0%,#0b7a3b 58%,#071421 100%);box-shadow:0 24px 54px rgba(7,20,33,.32);position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.28);"><div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:48px 48px;opacity:.45;"></div><div style="position:relative;z-index:2;max-width:720px;"><div style="display:inline-block;margin-bottom:12px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(247,201,72,.38);color:#fff5c2;font-size:12px;font-weight:800;text-transform:uppercase;">Gestion de club y competicion</div><div style="margin-bottom:12px;font-size:46px;line-height:1;font-weight:900;">Futbol WebApp</div><div style="max-width:650px;color:rgba(255,255,255,.84);font-size:17px;line-height:1.55;">Bienvenido.<br>Tu tablero para moverte rapido entre ligas, equipos, jugadores, entrenadores y posiciones.</div></div><div style="position:absolute;right:46px;top:30px;z-index:2;width:166px;height:166px;border-radius:50%;border:3px solid rgba(247,201,72,.84);background:rgba(7,20,33,.28);box-shadow:inset 0 0 0 10px rgba(255,255,255,.08),0 18px 34px rgba(0,0,0,.22);display:flex;align-items:center;justify-content:center;"><img src="Images/world-cup-trophy.png" alt="Copa" style="width:96px;height:96px;display:block;filter:drop-shadow(0 8px 14px rgba(0,0,0,.25));" /><img src="Images/football.png" alt="Balon" style="position:absolute;right:24px;bottom:22px;width:48px;height:48px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.28));" /></div><div style="position:absolute;right:-58px;bottom:-74px;width:260px;height:260px;border:22px solid rgba(255,255,255,.12);border-radius:50%;"></div></div>'
    
                Procedure OnLoad
                    Send UpdateHTML ('<div style="min-height:226px;border-radius:8px;padding:34px 40px;margin:6px 6px 18px;color:#fff;background:radial-gradient(circle at 82% 26%,rgba(247,201,72,.28),transparent 24%),radial-gradient(circle at 92% 74%,rgba(230,57,70,.16),transparent 26%),linear-gradient(135deg,#071421 0%,#0b7a3b 58%,#071421 100%);box-shadow:0 24px 54px rgba(7,20,33,.32);position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.28);">' + ;
                                     '<div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:48px 48px;opacity:.45;"></div>' + ;
                                     '<div style="position:relative;z-index:2;max-width:720px;">' + ;
                                     '<div style="display:inline-block;margin-bottom:12px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(247,201,72,.38);color:#fff5c2;font-size:12px;font-weight:800;text-transform:uppercase;">Gestion de club y competicion</div>' + ;
                                     '<div style="margin-bottom:12px;font-size:46px;line-height:1;font-weight:900;">Futbol WebApp</div>' + ;
                                     '<div style="max-width:650px;color:rgba(255,255,255,.84);font-size:17px;line-height:1.55;">Bienvenido, ' - htmlEncode(psUserName(ghoWebSessionManager)) - '.<br>Tu tablero para moverte rapido entre ligas, equipos, jugadores, entrenadores y posiciones.</div>' + ;
                                     '</div>' + ;
                                     '<div style="position:absolute;right:46px;top:30px;z-index:2;width:166px;height:166px;border-radius:50%;border:3px solid rgba(247,201,72,.84);background:rgba(7,20,33,.28);box-shadow:inset 0 0 0 10px rgba(255,255,255,.08),0 18px 34px rgba(0,0,0,.22);display:flex;align-items:center;justify-content:center;"><img src="Images/world-cup-trophy.png" alt="Copa" style="width:96px;height:96px;display:block;filter:drop-shadow(0 8px 14px rgba(0,0,0,.25));" /><img src="Images/football.png" alt="Balon" style="position:absolute;right:24px;bottom:22px;width:48px;height:48px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.28));" /></div>' + ;
                                     '<div style="position:absolute;right:-58px;bottom:-74px;width:260px;height:260px;border:22px solid rgba(255,255,255,.12);border-radius:50%;"></div>' + ;
                                     '</div>')
                End_Procedure
                
            End_Object
    
            Object oTileEntrenador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set psCSSClass to "SoccerTile SoccerTile_Staff"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:172px;margin:6px;padding:24px;border-radius:8px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#123f2b,#071f18);box-shadow:0 18px 38px rgba(7,20,33,.26);border:1px solid rgba(255,255,255,.22);position:relative;overflow:hidden;"><div style="position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,201,72,.12),transparent 42%),repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 18px);"></div><div style="position:relative;z-index:2;width:72px;height:72px;margin-bottom:16px;border-radius:50%;border:2px solid rgba(247,201,72,.68);background:rgba(7,20,33,.28);display:flex;align-items:center;justify-content:center;color:#f7c948;font-size:24px;font-weight:900;"><img src="Images/coach.png" alt="Entrenador" style="width:44px;height:44px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));" /></div><div style="position:relative;z-index:2;margin-bottom:8px;font-size:24px;font-weight:850;">Entrenadores</div><div style="position:relative;z-index:2;max-width:260px;color:rgba(255,255,255,.78);font-size:14px;line-height:1.4;">Gestion tecnica de los equipos</div></div>'
                                
                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
    
            Object oTileEquipo is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set piColumnIndex to 8
                Set psCSSClass to "SoccerTile SoccerTile_Team"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:172px;margin:6px;padding:24px;border-radius:8px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f766e,#0b302b);box-shadow:0 18px 38px rgba(7,20,33,.26);border:1px solid rgba(255,255,255,.22);position:relative;overflow:hidden;"><div style="position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,201,72,.12),transparent 42%),repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 18px);"></div><div style="position:relative;z-index:2;width:72px;height:72px;margin-bottom:16px;border-radius:50%;border:2px solid rgba(247,201,72,.68);background:rgba(7,20,33,.28);display:flex;align-items:center;justify-content:center;color:#f7c948;font-size:24px;font-weight:900;"><img src="Images/team.png" alt="Equipo" style="width:46px;height:46px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));" /></div><div style="position:relative;z-index:2;margin-bottom:8px;font-size:24px;font-weight:850;">Equipos</div><div style="position:relative;z-index:2;max-width:260px;color:rgba(255,255,255,.78);font-size:14px;line-height:1.4;">Clubes asociados a cada liga</div></div>'
    
                WebRegisterPath ntNavigateForwardCustom oSelectEquipo
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
    
            Object oTileJugador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 8
                Set piColumnIndex to 16
                Set psCSSClass to "SoccerTile SoccerTile_Player"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:172px;margin:6px;padding:24px;border-radius:8px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#167047,#0e3b31);box-shadow:0 18px 38px rgba(7,20,33,.26);border:1px solid rgba(255,255,255,.22);position:relative;overflow:hidden;"><div style="position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,201,72,.12),transparent 42%),repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 18px);"></div><div style="position:relative;z-index:2;width:72px;height:72px;margin-bottom:16px;border-radius:50%;border:2px solid rgba(247,201,72,.68);background:rgba(7,20,33,.28);display:flex;align-items:center;justify-content:center;color:#f7c948;font-size:24px;font-weight:900;"><img src="Images/football.png" alt="Jugador" style="width:46px;height:46px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));" /></div><div style="position:relative;z-index:2;margin-bottom:8px;font-size:24px;font-weight:850;">Jugadores</div><div style="position:relative;z-index:2;max-width:260px;color:rgba(255,255,255,.78);font-size:14px;line-height:1.4;">Plantillas, datos y detalle individual</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectJugador
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
            
            Object oTilePosicion is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set psCSSClass to "SoccerTile SoccerTile_Position"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:172px;margin:6px;padding:24px;border-radius:8px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f8175,#102323);box-shadow:0 18px 38px rgba(7,20,33,.26);border:1px solid rgba(255,255,255,.22);position:relative;overflow:hidden;"><div style="position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,201,72,.12),transparent 42%),repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 18px);"></div><div style="position:relative;z-index:2;width:72px;height:72px;margin-bottom:16px;border-radius:50%;border:2px solid rgba(247,201,72,.68);background:rgba(7,20,33,.28);display:flex;align-items:center;justify-content:center;color:#f7c948;font-size:24px;font-weight:900;"><img src="Images/position.png" alt="Posicion" style="width:42px;height:42px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));" /></div><div style="position:relative;z-index:2;margin-bottom:8px;font-size:24px;font-weight:850;">Posiciones</div><div style="position:relative;z-index:2;max-width:260px;color:rgba(255,255,255,.78);font-size:14px;line-height:1.4;">Roles dentro del campo de juego</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectPosicion
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
             End_Object
                        
             Object oTileLiga is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 12
                Set piColumnIndex to 12
                Set psCSSClass to "SoccerTile SoccerTile_League"
                Set psHtml to '<div data-ServerOnClick="openview" style="min-height:172px;margin:6px;padding:24px;border-radius:8px;color:#fff;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#15803d,#0a2f22);box-shadow:0 18px 38px rgba(7,20,33,.26);border:1px solid rgba(255,255,255,.22);position:relative;overflow:hidden;"><div style="position:absolute;inset:0;background:linear-gradient(120deg,rgba(247,201,72,.12),transparent 42%),repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 18px);"></div><div style="position:relative;z-index:2;width:72px;height:72px;margin-bottom:16px;border-radius:50%;border:2px solid rgba(247,201,72,.68);background:rgba(7,20,33,.28);display:flex;align-items:center;justify-content:center;color:#f7c948;font-size:24px;font-weight:900;"><img src="Images/world-cup-trophy.png" alt="Liga" style="width:46px;height:46px;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.25));" /></div><div style="position:relative;z-index:2;margin-bottom:8px;font-size:24px;font-weight:850;">Ligas</div><div style="position:relative;z-index:2;max-width:260px;color:rgba(255,255,255,.78);font-size:14px;line-height:1.4;">Competiciones, paises y cupos</div></div>'
            
                WebRegisterPath ntNavigateForwardCustom oSelectLiga
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
                
            End_Object
        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
        // Each time this view is shown we will update the appropriate information.
    End_Procedure

End_Object






