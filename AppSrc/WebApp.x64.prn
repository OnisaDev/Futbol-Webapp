37726>>>
37726>>>    Procedure SetActionButtons
37729>>>        tWebNavigateData NavigateData
37729>>>        tWebNavigateData NavigateData
37729>>>        Boolean bHasRecord
37729>>>        Handle hoDD
37729>>>
37729>>>        Get Server to hoDD
37730>>>        Get GetNavigateData to NavigateData
37731>>>        Get HasRecord of hoDD to bHasRecord
37732>>>
37732>>>        // let's hide all buttons and then Show the ones we want
37732>>>        WebSet pbRender of oEditBtn to False
37733>>>        WebSet pbRender of oSaveBtn to False
37734>>>        WebSet pbRender of oCancelChangesBtn to False
37735>>>        WebSet pbRender of oDeleteBtn to False
37736>>>
37736>>>        If (NavigateData.bReadOnly) Begin
37738>>>            WebSet pbRender of oEditBtn to True
37739>>>        End
37739>>>>
37739>>>        Else Begin
37740>>>            WebSet pbRender of oSaveBtn to True
37741>>>            WebSet pbRender of oCancelChangesBtn to True
37742>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37743>>>        End
37743>>>>
37743>>>    End_Procedure
37744>>>
37744>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37747>>>        // Close after save
37747>>>        Send NavigateClose Self
37748>>>    End_Procedure
37749>>>
37749>>>    // this will close the view after a delete
37749>>>    Procedure OnViewDeleted Handle hoDDO
37752>>>        Send NavigateClose Self
37753>>>    End_Procedure
37754>>>
37754>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37757>>>        Case Begin
37757>>>            Case (NavigateData.eNavigateType = nfFromMain)
37759>>>                // If from main, this is a propbably a main file Select to Zoom.
37759>>>                Case Break
37760>>>
37760>>>            Case (NavigateData.eNavigateType = nfFromParent)
37763>>>                // If from parent, this is a constrained drill down.
37763>>>                Case Break
37764>>>
37764>>>            Case (NavigateData.eNavigateType = nfFromChild)
37767>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37767>>>                Case Break
37768>>>
37768>>>            Case Else // must be nfUndefined
37768>>>
37768>>>        Case End
37768>>>
37768>>>        Send SetActionButtons
37769>>>
37769>>>    End_Procedure
37770>>>
37770>>>End_Object 
