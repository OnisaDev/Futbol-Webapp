37919>>>>>    
37919>>>>>    Procedure Construct_Object
37921>>>>>        Forward Send Construct_Object
37923>>>>>        
37923>>>>>        Set Main_File to entrenador.File_Number
37924>>>>>
37924>>>>>        Set Add_Server_File to equipo.File_Number
37925>>>>>
37925>>>>>        Set Add_Client_File to hijoentrenador.File_Number
37926>>>>>
37926>>>>>        Set ParentNullAllowed equipo.File_Number to True
37927>>>>>
37927>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
37928>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
37929>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
37930>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
37931>>>>>        
