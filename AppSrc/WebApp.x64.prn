37763>>>
37763>>>    Procedure SetActionButtons
37766>>>        tWebNavigateData NavigateData
37766>>>        tWebNavigateData NavigateData
37766>>>        Boolean bHasRecord
37766>>>        Handle hoDD
37766>>>
37766>>>        Get Server to hoDD
37767>>>        Get GetNavigateData to NavigateData
37768>>>        Get HasRecord of hoDD to bHasRecord
37769>>>
37769>>>        // let's hide all buttons and then Show the ones we want
37769>>>        WebSet pbRender of oEditBtn to False
37770>>>        WebSet pbRender of oSaveBtn to False
37771>>>        WebSet pbRender of oCancelChangesBtn to False
37772>>>        WebSet pbRender of oDeleteBtn to False
37773>>>
37773>>>        If (NavigateData.bReadOnly) Begin
37775>>>            WebSet pbRender of oEditBtn to True
37776>>>        End
37776>>>>
37776>>>        Else Begin
37777>>>            WebSet pbRender of oSaveBtn to True
37778>>>            WebSet pbRender of oCancelChangesBtn to True
37779>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37780>>>        End
37780>>>>
37780>>>    End_Procedure
37781>>>
37781>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37784>>>        // Close after save
37784>>>        Send NavigateClose Self
37785>>>    End_Procedure
37786>>>
37786>>>    // this will close the view after a delete
37786>>>    Procedure OnViewDeleted Handle hoDDO
37789>>>        Send NavigateClose Self
37790>>>    End_Procedure
37791>>>
37791>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37794>>>        Case Begin
37794>>>            Case (NavigateData.eNavigateType = nfFromMain)
37796>>>                // If from main, this is a propbably a main file Select to Zoom.
37796>>>                Case Break
37797>>>
37797>>>            Case (NavigateData.eNavigateType = nfFromParent)
37800>>>                // If from parent, this is a constrained drill down.
37800>>>                Case Break
37801>>>
37801>>>            Case (NavigateData.eNavigateType = nfFromChild)
37804>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37804>>>                Case Break
37805>>>
37805>>>            Case Else // must be nfUndefined
37805>>>
37805>>>        Case End
37805>>>
37805>>>        Send SetActionButtons
37806>>>
37806>>>    End_Procedure
37807>>>
37807>>>End_Object 
