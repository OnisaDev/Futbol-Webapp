37717>>>        WebSet pbRender of oNewButton to True
37718>>>        WebSet pbRender of oDetailButton to True
37719>>>
37719>>>        Case Begin
37719>>>            Case (NavigateData.eNavigateType = nfFromParent)
37721>>>                // If from parent, this is a constrained drill down
37721>>>                Case Break
37722>>>
37722>>>            Case (NavigateData.eNavigateType = nfFromChild)
37725>>>                // If from child, this is a probably a parent lookup from a Zoom
37725>>>                Case Break
37726>>>
37726>>>            Case (NavigateData.eNavigateType = nfFromMain)
37729>>>                // If from main, this is a probably a main-file lookup from a Zoom
37729>>>                WebSet pbRender of oDetailButton to False
37730>>>                Case Break
37731>>>
37731>>>            Case Else // must be nfUndefined
37731>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37731>>>
37731>>>        Case End
37731>>>
37731>>>    End_Procedure
37732>>>
