37630>>>WebRegisterPath ntNavigateForward oZoomEntrenador
37636>>>
37636>>>        Procedure OnRowClick String sRowId
37639>>>            tWebNavigateData NavigateData
37639>>>            tWebNavigateData NavigateData
37639>>>            Get GetNavigateData to NavigateData
37640>>>
37640>>>            Case Begin
37640>>>                Case (NavigateData.eNavigateType = nfFromParent)
37642>>>
37642>>>//Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
37642>>>                    Send NavigateForward of oZoomEntrenador Self
37643>>>                    Case Break
37644>>>
37644>>>                Case (NavigateData.eNavigateType = nfFromChild)
37647>>>                    Send NavigateClose Self
37648>>>                    Case Break
37649>>>
37649>>>                Case (NavigateData.eNavigateType = nfFromMain)
37652>>>                    Send NavigateForward of oZoomEntrenador Self
37653>>>                    Case Break
37654>>>
37654>>>                Case Else // must be nfUndefined
37654>>>
37654>>>//Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
37654>>>                    Send NavigateForward of oZoomEntrenador Self
37655>>>
37655>>>            Case End
37655>>>        End_Procedure
37656>>>
37656>>>        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
37659>>>            Move True to NavigateData.bReadOnly
37660>>>        End_Procedure
37661>>>
37661>>>    End_Object 
