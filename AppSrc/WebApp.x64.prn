38856>>>    Procedure SetActionButtons
38859>>>        tWebNavigateData NavigateData
38859>>>        tWebNavigateData NavigateData
38859>>>        Boolean bHasRecord
38859>>>        Handle hoDD
38859>>>
38859>>>        Get Server to hoDD
38860>>>        Get GetNavigateData to NavigateData
38861>>>        Get HasRecord of hoDD to bHasRecord
38862>>>
38862>>>        // let's hide all buttons and then Show the ones we want
38862>>>        WebSet pbRender of oEditBtn to False
38863>>>        WebSet pbRender of oSaveBtn to False
38864>>>        WebSet pbRender of oCancelChangesBtn to False
38865>>>        WebSet pbRender of oDeleteBtn to False
38866>>>        WebSet pbRender of oDespedirBtn to False
38867>>>
38867>>>        If (NavigateData.bReadOnly) Begin
38869>>>            WebSet pbRender of oEditBtn to True
38870>>>        End
38870>>>>
38870>>>        Else Begin
38871>>>            WebSet pbRender of oSaveBtn to True
38872>>>            WebSet pbRender of oCancelChangesBtn to True
38873>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38874>>>        End
38874>>>>
38874>>>        
38874>>>        WebSet pbRender of oDespedirBtn to bHasRecord 
38875>>>        
38875>>>    End_Procedure
38876>>>
