39241>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39244>>>        Case Begin
39244>>>            Case (NavigateData.eNavigateType = nfFromMain)
39246>>>                // If from main, this is a propbably a main file Select to Zoom.
39246>>>              
39246>>>                // InvokingObject = handle del objeto que disparó la navegación
39246>>>                // En este caso es el oDetailButton de SelectLiga (handle 274)
39246>>>                // Demuestra que InvokingObject identifica qué botón/objeto inició el salto de vista
39246>>>                Send ShowInfoBox (String(hoInvokingObject)) "InvokingObject"
39247>>>                Case Break
39248>>>                
39248>>>            Case (NavigateData.eNavigateType = nfFromParent)
39251>>>                // If from parent, this is a constrained drill down.
39251>>>                Case Break
39252>>>
39252>>>            Case (NavigateData.eNavigateType = nfFromChild)
39255>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39255>>>                Case Break
39256>>>
39256>>>            Case Else // must be nfUndefined
39256>>>
39256>>>        Case End
39256>>>
39256>>>        Send SetActionButtons
39257>>>        
39257>>>    End_Procedure
