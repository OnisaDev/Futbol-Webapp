37709>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37712>>>        WebSet pbRender of oNewButton to True
37713>>>        WebSet pbRender of oDetailButton to True
37714>>>
37714>>>        Case Begin
37714>>>            Case (NavigateData.eNavigateType = nfFromParent)
37716>>>                // If from parent, this is a constrained drill down
37716>>>                Case Break
37717>>>
37717>>>            Case (NavigateData.eNavigateType = nfFromChild)
37720>>>                // If from child, this is a probably a parent lookup from a Zoom
37720>>>                Case Break
37721>>>
37721>>>            Case (NavigateData.eNavigateType = nfFromMain)
37724>>>                // If from main, this is a probably a main-file lookup from a Zoom
37724>>>                WebSet pbRender of oDetailButton to False
37725>>>                Case Break
37726>>>
37726>>>            Case Else // must be nfUndefined
37726>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37726>>>
37726>>>        Case End
37726>>>
37726>>>    End_Procedure
37727>>>
37727>>>
37727>>>End_Object 
