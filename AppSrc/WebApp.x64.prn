38445>>>        Object oDespedirBtn is a cWebMenuItem
38447>>>            Set psCaption to "Despedir"
38448>>>            Set peActionDisplay to adMenu
38449>>>
38449>>>            Procedure OnClick
38452>>>                Integer iId
38452>>>                String sSQL
38452>>>                Handle hoConnection hoStatement
38452>>>
38452>>>                Move entrenador.ID to iId
38453>>>                If (iId = 0) Procedure_Return
38456>>>
38456>>>                Move ("UPDATE entrenador SET EquipoID = NULL WHERE ID = " + String(iId)) to sSQL
38457>>>
38457>>>                Get SQLFileConnect of oSQLHandleManager entrenador.File_Number to hoConnection
38458>>>                If (hoConnection <> 0) Begin
38460>>>                    Get SQLOpen of hoConnection to hoStatement
38461>>>                    If (hoStatement <> 0) Begin
38463>>>                        Send SQLExecDirect of hoStatement sSQL
38464>>>                        Send SQLClose to hoStatement
38465>>>                    End
38465>>>>
38465>>>                    Send SQLDisconnect to hoConnection
38466>>>                End
38466>>>>
38466>>>
38466>>>                Send NavigateClose Self
38467>>>            End_Procedure
