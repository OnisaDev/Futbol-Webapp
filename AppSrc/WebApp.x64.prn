39212>>>    Procedure SetActionButtons
39215>>>        tWebNavigateData NavigateData
39215>>>        tWebNavigateData NavigateData
39215>>>        Boolean bHasRecord
39215>>>        Handle hoDD
39215>>>
39215>>>        Get Server to hoDD
39216>>>        Get GetNavigateData to NavigateData
39217>>>        Get HasRecord of hoDD to bHasRecord
39218>>>
39218>>>        // let's hide all buttons and then Show the ones we want
39218>>>        WebSet pbRender of oEditBtn to False
39219>>>        WebSet pbRender of oSaveBtn to False
39220>>>        WebSet pbRender of oCancelChangesBtn to False
39221>>>        WebSet pbRender of oDeleteBtn to False
39222>>>    
39222>>>        //Mantenemos el boton Equipos siempre visible independientemente del modo (Lectura/Edición)
39222>>>        WebSet pbRender of oEquiposBtn to True
39223>>>        
39223>>>        
39223>>>        If (NavigateData.bReadOnly) Begin
39225>>>            WebSet pbRender of oEditBtn to True
39226>>>        End
39226>>>>
39226>>>        Else Begin
39227>>>            WebSet pbRender of oSaveBtn to True
39228>>>            WebSet pbRender of oCancelChangesBtn to True
39229>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39230>>>        End
39230>>>>
39230>>>    End_Procedure
39231>>>
39231>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39234>>>        // Close after save
39234>>>        Send NavigateClose Self
39235>>>    End_Procedure
39236>>>
39236>>>    // this will close the view after a delete
39236>>>    Procedure OnViewDeleted Handle hoDDO
39239>>>        Send NavigateClose Self
39240>>>    End_Procedure
