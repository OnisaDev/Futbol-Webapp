38891>>>                Case Break
38892>>>
38892>>>            Case (NavigateData.eNavigateType = nfFromParent)
38895>>>                // If from parent, this is a constrained drill down.
38895>>>                Case Break
38896>>>
38896>>>            Case (NavigateData.eNavigateType = nfFromChild)
38899>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38899>>>                Case Break
38900>>>
38900>>>            Case Else // must be nfUndefined
38900>>>
38900>>>        Case End
38900>>>
38900>>>        Send SetActionButtons
38901>>>
38901>>>    End_Procedure
