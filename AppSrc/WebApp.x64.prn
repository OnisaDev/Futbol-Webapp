38131>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38134>>>        WebSet pbRender of oNewButton to True
38135>>>        WebSet pbRender of oDetailButton to True
38136>>>
38136>>>        Case Begin
38136>>>            Case (NavigateData.eNavigateType = nfFromParent)
38138>>>                // If from parent, this is a constrained drill down
38138>>>                Case Break
38139>>>
38139>>>            Case (NavigateData.eNavigateType = nfFromChild)
38142>>>                // If from child, this is a probably a parent lookup from a Zoom
38142>>>                Case Break
38143>>>
38143>>>            Case (NavigateData.eNavigateType = nfFromMain)
38146>>>                // If from main, this is a probably a main-file lookup from a Zoom
38146>>>                WebSet pbRender of oDetailButton to False
38147>>>                Case Break
38148>>>
38148>>>            Case Else // must be nfUndefined
38148>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38148>>>
38148>>>        Case End
38148>>>
38148>>>    End_Procedure
38149>>>
38149>>>
38149>>>End_Object 
