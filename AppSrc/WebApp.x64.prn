38893>>>    Procedure SetActionButtons
38896>>>        tWebNavigateData NavigateData
38896>>>        tWebNavigateData NavigateData
38896>>>        Boolean bHasRecord
38896>>>        Handle hoDD
38896>>>
38896>>>        Get Server to hoDD
38897>>>        Get GetNavigateData to NavigateData
38898>>>        Get HasRecord of hoDD to bHasRecord
38899>>>
38899>>>        // let's hide all buttons and then Show the ones we want
38899>>>        WebSet pbRender of oEditBtn to False
38900>>>        WebSet pbRender of oSaveBtn to False
38901>>>        WebSet pbRender of oCancelChangesBtn to False
38902>>>        WebSet pbRender of oDeleteBtn to False
38903>>>        WebSet pbRender of oDespedirBtn to False
38904>>>
38904>>>        If (NavigateData.bReadOnly) Begin
38906>>>            WebSet pbRender of oEditBtn to True
38907>>>        End
38907>>>>
38907>>>        Else Begin
38908>>>            WebSet pbRender of oSaveBtn to True
38909>>>            WebSet pbRender of oCancelChangesBtn to True
38910>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38911>>>        End
38911>>>>
38911>>>        
38911>>>        WebSet pbRender of oDespedirBtn to bHasRecord 
38912>>>        
38912>>>    End_Procedure
38913>>>
38913>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38916>>>        // Close after save
38916>>>        Send NavigateClose Self
38917>>>    End_Procedure
38918>>>
38918>>>    // this will close the view after a delete
38918>>>    Procedure OnViewDeleted Handle hoDDO
38921>>>        Send NavigateClose Self
38922>>>    End_Procedure
