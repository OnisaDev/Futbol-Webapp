38928>>>                // If from main, this is a propbably a main file Select to Zoom.
38928>>>                Case Break
38929>>>
38929>>>            Case (NavigateData.eNavigateType = nfFromParent)
38932>>>                // If from parent, this is a constrained drill down.
38932>>>                Case Break
38933>>>
38933>>>            Case (NavigateData.eNavigateType = nfFromChild)
38936>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38936>>>                Case Break
38937>>>
38937>>>            Case Else // must be nfUndefined
38937>>>
38937>>>        Case End
38937>>>
38937>>>        Send SetActionButtons
38938>>>
38938>>>    End_Procedure
38939>>>
38939>>>End_Object 
