39666>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39669>>>        Case Begin
39669>>>            Case (NavigateData.eNavigateType = nfFromMain)
39671>>>                // If from main, this is a propbably a main file Select to Zoom.
39671>>>              
39671>>>                // InvokingObject = handle del objeto que disparó la navegación
39671>>>                // En este caso es el oDetailButton de SelectLiga (handle 274)
39671>>>                // Demuestra que InvokingObject identifica qué botón/objeto inició el salto de vista
39671>>>                Send ShowInfoBox (String(hoInvokingObject)) "InvokingObject"
39672>>>                Case Break
39673>>>                
39673>>>            Case (NavigateData.eNavigateType = nfFromParent)
39676>>>                // If from parent, this is a constrained drill down.
39676>>>                Case Break
39677>>>
39677>>>            Case (NavigateData.eNavigateType = nfFromChild)
39680>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39680>>>                Case Break
39681>>>
39681>>>            Case Else // must be nfUndefined
39681>>>
39681>>>        Case End
39681>>>
39681>>>        Send SetActionButtons
39682>>>        
39682>>>    End_Procedure
39683>>>
