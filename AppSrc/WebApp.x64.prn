37696>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37699>>>        WebSet pbRender of oNewButton to True
37700>>>        WebSet pbRender of oDetailButton to True
37701>>>
37701>>>        Case Begin
37701>>>            Case (NavigateData.eNavigateType = nfFromParent)
37703>>>                // If from parent, this is a constrained drill down
37703>>>                Case Break
37704>>>
37704>>>            Case (NavigateData.eNavigateType = nfFromChild)
37707>>>                // If from child, this is a probably a parent lookup from a Zoom
37707>>>                Case Break
37708>>>
37708>>>            Case (NavigateData.eNavigateType = nfFromMain)
37711>>>                // If from main, this is a probably a main-file lookup from a Zoom
37711>>>                WebSet pbRender of oDetailButton to False
37712>>>                Case Break
37713>>>
37713>>>            Case Else // must be nfUndefined
37713>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37713>>>
37713>>>        Case End
37713>>>
37713>>>    End_Procedure
37714>>>
37714>>>
37714>>>End_Object 
